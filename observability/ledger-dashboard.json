{
  "title": "Ledger API Overview",
  "uid": "ledger-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "requests/sec"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM heap memory used",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "{{id}}"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP request p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process CPU usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "process_cpu_usage", "legendFormat": "CPU"}]
    }
  ]
}